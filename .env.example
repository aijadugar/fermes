# ── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Auth ────────────────────────────────────────────────
# Set this to require a token on /v1/agent/*. Leave blank to disable
# (a warning is logged at startup when disabled).
AUTH_API_TOKEN=

# ── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for any.
ALLOWED_ORIGINS=*

# ── Rate limiting ───────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=30

# ── Session store ───────────────────────────────────────
SESSION_TTL_SECONDS=3600
SESSION_MAX_MESSAGES=20
# Set REDIS_URL to use Redis instead of in-memory storage.
# REDIS_URL=redis://localhost:6379

# ── HTTP client (upstream calls) ─────────────────────────
HTTP_TIMEOUT_MS=30000
HTTP_RETRIES=2

# ── Sarvam AI — https://dashboard.sarvam.ai ──────────────
SARVAM_API_KEY=sk_xxx
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_BASE_URL=https://api.sarvam.ai

# ── Mireye — https://www.mireye.com (US/Canada coverage) ──
# Confirm the real API base URL from your Mireye dashboard.
MIREYE_API_KEY=mireye_xxx
MIREYE_BASE_URL=https://api.mireye.com

# ── Google Places (nearby businesses) ────────────────────
GOOGLE_PLACES_API_KEY=xxx
